---
import PageLayout from '../../layouts/PageLayout.astro';
import LatticeCard from '../../components/LatticeCard.astro';
import { getCollection } from 'astro:content';

const themes = ['math', 'engineering', 'accounting', 'bio', 'physiology', 'psychology', 'other'] as const;
const themeLabels: Record<string, string> = {
  math: 'Math',
  engineering: 'Engineering',
  accounting: 'Accounting',
  bio: 'Bio',
  physiology: 'Physiology',
  psychology: 'Psychology',
  other: 'Other',
};
const themeOrder: Record<string, number> = { math: 0, engineering: 1, accounting: 2, bio: 3, physiology: 4, psychology: 5, other: 6 };

const all = await getCollection('lattice', ({ data }) => !data.draft);
const entries = all.sort((a, b) => {
  const t = (themeOrder[a.data.theme] ?? 9) - (themeOrder[b.data.theme] ?? 9);
  return t !== 0 ? t : a.data.title.localeCompare(b.data.title);
});
---

<PageLayout title="Lattice — Finn Stäblein" description="A lattice of mental models and frameworks I'm picking up.">
  <div class="lattice-page">
    <div class="lattice-header">
      <h1>Lattice</h1>
      <p class="lattice-intro">
        A growing lattice of mental models across disciplines — rooted in Charlie Munger's idea that genuine understanding comes from building a latticework of world models, not from one-dimensional expertise. Most of the entries below live under "Other" for now; I'm sorting them into Math, Engineering, Accounting, Bio, Physiology, and Psychology as I go.
      </p>
    </div>

    <div class="lattice-controls">
      <div class="filter-buttons" role="group" aria-label="Filter by theme">
        {themes.map(t => (
          <button class="filter-btn" data-filter={t}>{themeLabels[t]}</button>
        ))}
      </div>
      <span class="mono lattice-count" id="lattice-count">{entries.length} entries</span>
    </div>

    <div class="lattice-table">
      <div class="table-header">
        <span class="col-index mono">No.</span>
        <span class="col-title">Term</span>
        <span class="col-summary">What it means</span>
        <span class="col-theme mono">Theme</span>
      </div>

      <div id="lattice-list">
        {entries.map((entry, i) => (
          <LatticeCard
            id={entry.id}
            index={i + 1}
            title={entry.data.title}
            summary={entry.data.summary}
            theme={entry.data.theme}
          />
        ))}
      </div>
    </div>

    <p class="no-results" id="no-results" style="display: none;">No entries found.</p>
  </div>
</PageLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const list = document.getElementById('lattice-list');
    const countEl = document.getElementById('lattice-count');
    const noResults = document.getElementById('no-results');
    if (!list) return;

    const cards = list.querySelectorAll<HTMLAnchorElement>('.lattice-row');

    // No default filter on first load; remember the last choice.
    let activeTheme: string | null = sessionStorage.getItem('lattice-filter') || null;

    function setActiveButton() {
      filterButtons.forEach(b => b.classList.toggle('active', b.dataset.filter === activeTheme));
    }

    function apply() {
      let visible = 0;
      cards.forEach(card => {
        const show = !activeTheme || card.dataset.theme === activeTheme;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countEl) countEl.textContent = `${visible} entr${visible !== 1 ? 'ies' : 'y'}`;
      if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || '';
        if (activeTheme === filter) {
          activeTheme = null;
          sessionStorage.removeItem('lattice-filter');
        } else {
          activeTheme = filter;
          sessionStorage.setItem('lattice-filter', filter);
        }
        setActiveButton();
        apply();
      });
    });

    setActiveButton();
    apply();
  });
</script>

<style>
  .lattice-page {
    max-width: var(--max-width);
  }

  .lattice-header h1 {
    font-size: var(--text-2xl);
    font-weight: 400;
    margin-bottom: var(--space-4);
  }

  .lattice-intro {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin-bottom: var(--space-8);
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .filter-buttons {
    display: flex;
    gap: var(--space-4);
  }

  .filter-btn {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: 0;
    transition: color var(--duration-fast) ease;
  }

  .filter-btn:hover {
    color: var(--color-text);
  }

  .filter-btn.active {
    color: var(--color-accent);
  }

  .lattice-count {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .lattice-table {
    border-top: 1px solid var(--color-border);
  }

  .table-header {
    display: grid;
    grid-template-columns: 36px 220px 1fr 90px;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-secondary);
  }

  .table-header .col-theme {
    text-align: right;
  }

  .no-results {
    text-align: center;
    color: var(--color-text-secondary);
    padding: var(--space-16) 0;
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .table-header {
      grid-template-columns: 36px 1fr 72px;
    }
    .table-header .col-summary {
      display: none;
    }
  }
</style>
